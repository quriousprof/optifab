# ── Backend ───────────────────────────────────────────────────────────
# Gemini API key (get from https://aistudio.google.com/apikey)
OPTIFAB_GEMINI_API_KEY=
# OPTIFAB_GEMINI_MODEL=gemini-flash-latest

# CORS – set to your Cloud Run frontend URL (the deploy script handles this automatically)
# OPTIFAB_CORS_ORIGINS=https://optifab-frontend-xxxxx-xx.a.run.app

# QAOA tuning (defaults are fine for the demo)
# OPTIFAB_QAOA_DEPTH=2
# OPTIFAB_QAOA_SHOTS=1024
# OPTIFAB_QAOA_OPTIMIZER_MAXITER=100

# Firestore – set a GCP project to use Firestore; leave empty for local JSON
OPTIFAB_GCP_PROJECT=
