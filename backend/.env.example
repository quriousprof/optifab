# Gemini API key (get from https://aistudio.google.com/apikey)
OPTIFAB_GEMINI_API_KEY=
# OPTIFAB_GEMINI_MODEL=gemini-flash-latest

# QAOA tuning (defaults are fine for the demo)
# OPTIFAB_QAOA_DEPTH=2
# OPTIFAB_QAOA_SHOTS=1024
# OPTIFAB_QAOA_OPTIMIZER_MAXITER=100


# Saved layouts: set a GCP project to use Firestore (needs `gcloud auth application-default login`);
# leave empty to save JSON files under backend/data/layouts/
OPTIFAB_GCP_PROJECT=
